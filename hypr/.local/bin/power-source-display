#!/usr/bin/env bash
set -uo pipefail

POWER_STATE_FILE=${POWER_STATE_FILE:-/sys/class/power_supply/ACAD/online}
BRIGHTNESSCTL_BIN=${BRIGHTNESSCTL_BIN:-brightnessctl}
HYPRCTL_BIN=${HYPRCTL_BIN:-hyprctl}
UPOWER_BIN=${UPOWER_BIN:-upower}
# USB-C PD on this Framework bounces ACAD/online for ~2s on plug-in.
# Wait for a quiet stretch before applying, so 60↔120 Hz does not modeset
# three times in a row.
POWER_EVENT_SETTLE_SECONDS=${POWER_EVENT_SETTLE_SECONDS:-2.5}
LAST_POWER_STATE=

log() {
  printf 'power-source-display: %s\n' "$*" >&2
}

edp_refresh_hz() {
  "$HYPRCTL_BIN" monitors all | awk '
    /^Monitor eDP-1 / { hit = 1; next }
    /^Monitor / { hit = 0 }
    hit && $1 ~ /^[0-9]+x[0-9]+@/ {
      sub(/.*@/, "", $1)
      split($1, a, ".")
      print a[1]
      exit
    }
  '
}

apply_current_power_state() {
  local state brightness refresh current_refresh

  if [[ ! -r "$POWER_STATE_FILE" ]]; then
    log "cannot read $POWER_STATE_FILE"
    return 1
  fi

  read -r state <"$POWER_STATE_FILE"
  if [[ "$state" != 0 && "$state" != 1 ]]; then
    log "unexpected AC state: $state"
    return 1
  fi

  [[ "$state" == "$LAST_POWER_STATE" ]] && return 0
  LAST_POWER_STATE=$state

  if ! "$HYPRCTL_BIN" monitors all | grep -q '^Monitor eDP-1 '; then
    log 'eDP-1 is unavailable; leaving displays unchanged'
    return 0
  fi

  if [[ "$state" == 0 ]]; then
    brightness=60
    refresh=60
  else
    brightness=100
    refresh=120
  fi

  "$BRIGHTNESSCTL_BIN" -q --device intel_backlight set "${brightness}%" \
    || log "failed to set brightness to ${brightness}%"

  current_refresh=$(edp_refresh_hz)
  if [[ "$current_refresh" == "$refresh" ]]; then
    log "eDP-1 already ${refresh} Hz; skipping modeset"
    return 0
  fi

  "$HYPRCTL_BIN" eval \
    "hl.monitor({ output = \"eDP-1\", mode = \"2880x1920@${refresh}\", position = \"0x0\", scale = 2 })" \
    || log "failed to set eDP-1 to ${refresh} Hz"
}

watch_power_source() {
  apply_current_power_state || true
  while IFS= read -r _; do
    while IFS= read -r -t "$POWER_EVENT_SETTLE_SECONDS" _; do
      :
    done
    apply_current_power_state || true
  done < <("$UPOWER_BIN" --monitor)
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  watch_power_source
fi
