{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "plugin": [
    "opencode-gemini-auth@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "cleat@git+https://github.com/jturmel/cleat.git#v0.5.0"
  ],
  "provider": {
    "google": {
      "options": {
        "projectId": "turmel"
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {}
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      "temperature": 0.1,
      "mode": "primary"
    },
    "plan-writer": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      "temperature": 0.1,
      "mode": "primary"
    },
    "build": {
      "model": "openai/gpt-5.5",
      "mode": "primary",
      "reasoningEffort": "medium",
      "temperature": 0.1
    },
    "build-quick": {
      "model": "fireworks-ai/accounts/fireworks/routers/kimi-k2p5-turbo",
      "mode": "primary"
    },
    "build-subagent": {
      "model": "openai/gpt-5.3-codex",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "temperature": 0.1
    },
    "explore": {
      "model": "openai/gpt-5.3-codex",
      "mode": "subagent"
    },
    "general": {
      "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "medium",
      "mode": "subagent",
      "temperature": 0.1
    },
    "code-reviewer": {
      "name": "Code Reviewer",
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      "temperature": 0.1,
      "mode": "primary"
    }
  },
  "formatter": {
    "ruff": {
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "env:$TMPDIR": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ]
    }
  }
}
